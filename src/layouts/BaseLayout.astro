---
import { previewPath } from '../lib/paths.js';
const {
  title = 'Franziska Zimmer',
  description = 'Academic website of Franziska Zimmer',
  lang = 'en',
  alternates = []
} = Astro.props;
const locale = ['en','de','ja'].includes(lang) ? lang : 'en';
const menus = {
  en: [{name:'Home',href:'/'},{name:'About',href:'/about/'},{name:'Research',href:'/research/'},{name:'Contact',href:'/contact/'}],
  de: [{name:'Startseite',href:'/de/'},{name:'Über mich',href:'/de/ueber-mich/'},{name:'Forschung',href:'/de/forschung/'},{name:'Kontakt',href:'/de/kontakt/'}],
  ja: [{name:'ホーム',href:'/ja/'},{name:'プロフィール',href:'/ja/profile/'},{name:'研究実績',href:'/ja/kenkyu/'},{name:'お問い合わせ',href:'/ja/form/'}]
};
const current = Astro.url.pathname;
const productionOrigin = 'https://franziska-zimmer.com';
const basePath = import.meta.env.BASE_URL || '/';
const originalPath = basePath !== '/' && current.startsWith(basePath) ? '/' + current.slice(basePath.length) : current;
const canonical = new URL(originalPath, productionOrigin).toString();
const isHome = ['/', '/de/', '/ja/'].includes(originalPath);
const isOriginalAbout = originalPath === '/about/';
const isOriginalResearch = originalPath === '/research/';
const usesOverlayHeader = isHome || isOriginalAbout || isOriginalResearch;
const privacyLinks = {en:'/privacy-policy/',de:'/de/datenschutzerklaerung/',ja:'/ja/privacypolicy/'};
const homeLinks = {en:'/',de:'/de/',ja:'/ja/'};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#E9F8F9" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={previewPath("/wp-content/uploads/2026/03/cropped-logo2-32x32.png")} sizes="32x32" />
    {alternates.map((entry) => <link rel="alternate" hreflang={entry.lang} href={new URL(entry.href, productionOrigin).toString()} />)}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Serif:wght@600&family=Playfair+Display:wght@800&family=Barlow+Semi+Condensed:wght@500&display=swap" rel="stylesheet" />
  </head>
  <body class={usesOverlayHeader ? 'is-home' : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-wrap">
        <a class="brand" href={previewPath(homeLinks[locale])} aria-label="Franziska Zimmer home">
          <img
            src={previewPath("/wp-content/uploads/2026/03/cropped-名称未設定のデザイン1-317x106.png")}
            alt="Franziska Zimmer"
            width="317"
            height="106"
          />
        </a>
        <nav class="nav desktop-nav" aria-label="Primary site navigation">
          {menus[locale].map(link => <a href={previewPath(link.href)} aria-current={originalPath === link.href ? 'page' : undefined}>{link.name}</a>)}
          <details class="language-menu">
            <summary><span class="flag" aria-hidden="true">{locale === 'de' ? '🇩🇪' : locale === 'ja' ? '🇯🇵' : '🇬🇧'}</span> {locale === 'de' ? 'Deutsch' : locale === 'ja' ? '日本語' : 'English'} <span class="chevron" aria-hidden="true">⌄</span></summary>
            <div class="language-options">
              {([{id:'de',flag:'🇩🇪',name:'Deutsch'},{id:'en',flag:'🇬🇧',name:'English'},{id:'ja',flag:'🇯🇵',name:'日本語'}]).map(language => {
                const equivalent = alternates.find(a => a.lang === language.id);
                return <a href={previewPath(equivalent?.href || homeLinks[language.id])} lang={language.id} aria-current={locale === language.id ? 'page' : undefined}><span aria-hidden="true">{language.flag}</span> {language.name}</a>;
              })}
            </div>
          </details>
        </nav>
        <details class="mobile-menu">
          <summary aria-label="Toggle navigation"><span aria-hidden="true">☰</span></summary>
          <nav aria-label="Mobile site navigation">
            {menus[locale].map(link => <a href={previewPath(link.href)} aria-current={originalPath === link.href ? 'page' : undefined}>{link.name}</a>)}
            {([{id:'de',flag:'🇩🇪',name:'Deutsch'},{id:'en',flag:'🇬🇧',name:'English'},{id:'ja',flag:'🇯🇵',name:'日本語'}]).map(language => {
              const equivalent = alternates.find(a => a.lang === language.id);
              return <a href={previewPath(equivalent?.href || homeLinks[language.id])} lang={language.id}>{language.flag} {language.name}</a>;
            })}
          </nav>
        </details>
      </div>
    </header>
    <main class={isHome || isOriginalAbout || isOriginalResearch ? 'home-main' : 'shell page-main'} id="main"><slot /></main>
    <footer class="site-footer">
      <nav class="footer-nav" aria-label="Footer menu">
        <a href={previewPath(homeLinks[locale])}>{locale === 'ja' ? 'ホーム' : locale === 'de' ? 'Startseite' : 'Home'}</a>
        <a href={previewPath(privacyLinks[locale])}>{locale === 'ja' ? 'プライバシーポリシー' : locale === 'de' ? 'Datenschutzerklärung' : 'Privacy Policy'}</a>
        <a href={previewPath(menus[locale][1].href)}>{menus[locale][1].name}</a>
        <a href={previewPath(menus[locale][3].href)}>{menus[locale][3].name}</a>
        <a href={previewPath(menus[locale][2].href)}>{menus[locale][2].name}</a>
      </nav>
      <p>Copyright © {new Date().getFullYear()} Franziska Zimmer</p>
    </footer>
  </body>
</html>
<style is:global>
:root{--ast-global-color-0:#3AA6B9;--ast-global-color-1:#2997AA;--ast-global-color-2:#0F172A;--ast-global-color-3:#454F5E;--ast-global-color-4:#E9F8F9;--ast-global-color-5:#fff;--ast-global-color-6:#CAE6E8}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;font-size:100%}
body{margin:0;min-width:0;background:#e9f8f9;color:#454f5e;font-family:'Inter',Arial,sans-serif;font-size:16px;line-height:1.65}
img,video,iframe,svg{max-width:100%;height:auto}
a{color:#0f172a;overflow-wrap:anywhere;text-decoration:none}
a:hover,a:focus-visible{color:#2997aa}
.shell{width:min(calc(100% - 40px),1200px);margin-inline:auto}
.site-header{position:relative;z-index:10;background:#fff;border-bottom:1px solid #cae6e8}
.is-home .site-header{position:absolute;top:0;left:0;right:0;background:transparent;border-bottom:0}
.header-wrap{display:flex;align-items:center;justify-content:space-between;gap:2rem;min-height:108px}
.brand{display:inline-flex;align-items:center;flex:0 0 auto}
.brand img{width:307px;height:auto;display:block}
.is-home .brand img{width:150px}
.nav{display:flex;align-items:center;gap:clamp(1rem,2.3vw,2.5rem);font-size:15px;font-weight:500;text-transform:uppercase}
.nav>a{white-space:nowrap;color:#0f172a}
.nav>a:hover,.nav>a[aria-current="page"]{color:#3aa6b9}
.language-menu{position:relative;text-transform:none;font-size:14px}
.language-menu summary{list-style:none;display:flex;gap:.35rem;align-items:center;cursor:pointer;white-space:nowrap;color:#0f172a}
.language-menu summary::-webkit-details-marker{display:none}
.language-menu summary .flag{font-size:18px}
.chevron{font-size:18px;padding-left:3px}
.language-options{position:absolute;top:calc(100% + 10px);right:0;width:160px;background:#fff;border-top:2px solid #3aa6b9;box-shadow:0 10px 25px rgba(0,0,0,.1);padding:6px 0}
.language-options a{display:block;padding:9px 15px;color:#0f172a}
.language-options a:hover{background:#e9f8f9;color:#3aa6b9}
.mobile-menu{display:none;position:relative}
.mobile-menu summary{list-style:none;cursor:pointer;font-size:25px;background:#3aa6b9;color:#fff;width:40px;height:40px;display:grid;place-items:center;line-height:1}
.mobile-menu summary::-webkit-details-marker{display:none}
.mobile-menu nav{position:absolute;right:0;top:calc(100% + 12px);width:min(85vw,330px);background:#fff;box-shadow:0 20px 40px #0002;display:flex;flex-direction:column;max-height:75vh;overflow:auto}
.mobile-menu nav a{display:block;padding:13px 20px;border-bottom:1px solid #eaeaea;color:#0f172a;background:#e9f8f9}
.mobile-menu nav a:hover,.mobile-menu nav a[aria-current="page"]{color:#3aa6b9}
.home-main{padding:0;min-width:0;width:100%;overflow:hidden}
.page-main{min-height:68vh;padding-block:3rem 5rem;min-width:0}
h1{font-family:'Playfair Display',Georgia,serif;font-size:clamp(2.8rem,6vw,5.1875rem);font-weight:800;line-height:1.4;color:#0f172a}
h2{font-family:'Playfair Display',Georgia,serif;font-size:clamp(2rem,4vw,3.125rem);font-weight:800;line-height:1.3;color:#0f172a}
h3{font-family:'Playfair Display',Georgia,serif;font-size:clamp(1.5rem,3vw,2.1875rem);font-weight:800;line-height:1.3;color:#0f172a}
h4,h5,h6{font-family:'Barlow Semi Condensed',sans-serif}
p,li{line-height:1.85}
.site-footer{background:#fff;color:#454f5e;border-top:1px solid rgba(8,63,135,.05);padding:25px 20px 20px;min-height:160px;text-align:center;font-size:15px}
.site-footer p{margin:20px 0 0;font-size:14px}
.footer-nav{display:flex;align-items:center;flex-direction:column;gap:3px}
.footer-nav a{color:#3aa6b9}
.footer-nav a:hover{color:#2997aa}
.skip{position:absolute;left:-9999px}
.skip:focus{left:1rem;top:.5rem;z-index:99;background:#fff;border:2px solid #172940;padding:.3rem}
.imported-body{overflow-wrap:anywhere;min-width:0}
.imported-body img{max-width:100%;height:auto}
.imported-body table{display:block;max-width:100%;overflow-x:auto;border-collapse:collapse}
.imported-body td,.imported-body th{border:1px solid #dbe2eb;padding:.6rem}
.imported-body pre,.imported-body code{max-width:100%;overflow-x:auto;white-space:pre-wrap;overflow-wrap:anywhere}
.imported-body .form-notice{border-left:4px solid #3aa6b9;padding:.85rem 1rem;background:#e9f8f9}
.imported-body .wp-block-separator{border:0;border-top:1px solid #e6eaf1;margin:2rem 0}
.imported-body section{max-width:100%}
@media(max-width:921px){
 .header-wrap{min-height:100px}
 .nav{display:none}.mobile-menu{display:block}
 .brand img{width:min(45vw,317px)}
 .is-home .brand img{width:120px}
}
@media(max-width:544px){
 .header-wrap{min-height:90px}
 .brand img{width:min(65vw,282px)}
 .is-home .brand img{width:100px}
 html{font-size:91.2%}
 h1{font-size:45px}h2{font-size:35px}h3{font-size:20px}
 .page-main{padding-top:2rem}
}
</style>
