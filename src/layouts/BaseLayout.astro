---
const { title = 'Franziska Zimmer', description = 'Academic website of Franziska Zimmer', lang = 'en' } = Astro.props;
const links = [{href:'/',name:'Home'},{href:'/about/',name:'About'},{href:'/research/',name:'Research'},{href:'/contact/',name:'Contact'}];
---
<!doctype html>
<html lang={lang}>
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} /><title>{title}</title></head>
<body><header class="shell"><a class="brand" href="/">Franziska Zimmer</a><nav aria-label="Main navigation">{links.map(link => <a href={link.href} aria-current={Astro.url.pathname === link.href ? 'page' : undefined}>{link.name}</a>)}</nav></header><main class="shell"><slot /></main><footer class="shell">© {new Date().getFullYear()} Franziska Zimmer</footer></body>
</html>
<style is:global>
:root{font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#18243b;background:#fff;line-height:1.7}*{box-sizing:border-box}body{margin:0}a{color:#1767a3}.shell{width:min(100% - 2rem,980px);margin-inline:auto}header{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:1rem;padding-block:1.5rem;border-bottom:1px solid #e5eaf0}.brand{font-weight:750;font-size:1.3rem;text-decoration:none;color:#18243b}nav{display:flex;gap:1rem;flex-wrap:wrap}nav a{text-decoration:none}nav a[aria-current=page]{font-weight:700;text-decoration:underline}main{min-height:65vh;padding-block:3.5rem}h1{font-size:clamp(2rem,5vw,3.5rem);line-height:1.15}p{max-width:70ch}footer{padding-block:2rem;border-top:1px solid #e5eaf0;color:#64748b;font-size:.9rem}
</style>
