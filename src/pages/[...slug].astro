---
import ImportedContent from '../components/ImportedContent.astro';
import { content as publishedContent } from '../lib/content.js';

export function getStaticPaths() {
  // Astro evaluates this exported function in an isolated build context.
  // Keep values it references inside the function rather than frontmatter scope.
  const reservedPaths = new Set(['/', '/about/', '/research/', '/contact/']);
  return publishedContent
    .filter((item) => !reservedPaths.has(item.path))
    .map((item) => ({
      params: { slug: item.path.replace(/^\/|\/$/g, '') },
      props: { item },
    }));
}
const { item } = Astro.props;
---
<ImportedContent item={item} />
