---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts } from '../../lib/content.js';
---
<BaseLayout title="Blog | Franziska Zimmer" description="Articles and insights from Franziska Zimmer." lang="en">
  <div class="intro"><p class="eyebrow">ARTICLES</p><h1>Blog</h1><p>Research-related commentary and articles originally published on WordPress.</p></div>
  <div class="cards">
    {posts.map((post) => <article class="card">
      <time datetime={post.date}>{post.date}</time>
      <h2><a href={post.path}>{post.title}</a></h2>
      <p>{post.description}</p>
      <a class="read" href={post.path}>Read article →</a>
    </article>)}
  </div>
</BaseLayout>
<style>
.intro{margin-bottom:2rem}.eyebrow{font-size:.78rem;letter-spacing:.15em;color:#5064b0;font-weight:700}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:1.2rem}
.card{border:1px solid #e6eaf1;border-radius:16px;padding:1.4rem;background:#fff;box-shadow:0 6px 25px #1725540a;display:flex;flex-direction:column;gap:.4rem}
.card h2{font-size:1.15rem;line-height:1.4;margin:0}
.card a{text-decoration:none;color:#182d50}
.card a:hover{text-decoration:underline;color:#3558a6}
.card p{color:#526078;font-size:.93rem;line-height:1.65}
.card time{color:#64748b;font-size:.8rem}.card .read{margin-top:auto;color:#3155a0;font-weight:650;font-size:.9rem}
</style>
